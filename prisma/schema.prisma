// Configuración del Cliente
generator client {
  provider = "prisma-client-js"
}

// Configuración de la Base de Datos
datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

// ==========================================
// --- MODELOS DE USUARIO ---
// ==========================================

model TechUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("game_client")
  createdAt    DateTime @default(now())
}

model UserGamer {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  name            String?
  birthdate       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // --- ECONOMÍA ---
  nanocredits     Int       @default(0)
  premium_credits Int       @default(0)

  // --- RELACIONES ---
  pets            Pet[]
  cards           UserCard[] // Relación con el inventario de cartas
}

// ==========================================
// --- MODELO PRINCIPAL: PET ---
// ==========================================

model Pet {
  id                 String    @id @default(uuid())
  nickname           String    @default("Junior.sys")
  
  userId             String
  user               UserGamer @relation(fields: [userId], references: [id])

  especie_id         Int
  especieActual      Especie   @relation("EspecieActual", fields: [especie_id], references: [id])

  junior_original_id Int
  especieJunior      Especie   @relation("EspecieJunior", fields: [junior_original_id], references: [id])

  ancestro_id        Int
  especieAncestro    Especie   @relation("EspecieAncestro", fields: [ancestro_id], references: [id])

  etapa_evolutiva    Int       @default(0) 
  esta_enfermo       Boolean   @default(false)
  
  hp                 Float     @default(0.0)
  hp_entrenado       Float     @default(0.0)
  f_entrenada        Float     @default(0.0)
  a_entrenada        Float     @default(0.0)
  d_entrenada        Float     @default(0.0)
  md_acumulado       Float     @default(0.0)

  hambre             Float     @default(0.0) 
  suciedad           Float     @default(0.0) 

  ultima_conexion    DateTime  @updatedAt
  createdAt          DateTime  @default(now())
  fecha_expiracion   DateTime? 

  is_patrolling      Boolean   @default(false)
  patrol_end_time    DateTime? 
  patrol_type        String?   
  misionActual       MisionConfig? @relation(fields: [patrol_type], references: [codigo])

  training_ep             Int       @default(5)      
  training_ep_max         Int       @default(5)      
  last_ep_recovery        DateTime  @default(now())  
  training_sessions_today  Int      @default(0)      
  last_training_reset     DateTime  @default(now())  
  
  gym_fuerza_lv           Int       @default(1)
  gym_agilidad_lv         Int       @default(1)
  gym_defensa_lv          Int       @default(1)
}

// ==========================================
// --- SISTEMA DE CARTAS (TCG) ---
// ==========================================

model CardMaster {
  id                String   @id // Ej: "STR_001"
  nombre            String
  rareza            String   // Común, Rara, Épica, Legendaria
  tipo              String   // Ofensiva, Defensiva, Táctica, etc.
  energia           Int      
  efecto_principal  String   
  valor             Float    
  is_multiplier     Boolean  @default(false) 
  precio_oro        Int      @default(0)
  precio_bios       Int      @default(0)

  usuarios_que_la_tienen UserCard[]
}

model UserCard {
  id           String     @id @default(uuid())
  
  userId       String
  user         UserGamer  @relation(fields: [userId], references: [id])
  
  cardId       String
  cardMaster   CardMaster @relation(fields: [cardId], references: [id])

  cantidad     Int        @default(1) 
  en_mazo      Boolean    @default(false) 

  createdAt    DateTime   @default(now())

  @@unique([userId, cardId]) 
}

// ==========================================
// --- MODELOS DE CONFIGURACIÓN ---
// ==========================================

model Especie {
  id                Int          @id @default(autoincrement())
  nombre            String       @unique
  tipo              TipoEspecie
  rango             RangoEspecie
  hp_base           Float
  f_base            Float
  a_base            Float
  d_base            Float
  md_para_siguiente Float
  tasa_descarga     Float?
  prefab_model      String

  evolucionesComoOrigen  MapaEvolucion[] @relation("EvolucionesOrigen")
  evolucionesComoDestino MapaEvolucion[] @relation("EvolucionesDestino")

  petsActuales           Pet[]           @relation("EspecieActual")
  petsJunior             Pet[]           @relation("EspecieJunior")
  petsAncestro           Pet[]           @relation("EspecieAncestro")
}

model MapaEvolucion {
  id                 Int            @id @default(autoincrement())
  especie_origen_id  Int
  especieOrigen      Especie        @relation("EvolucionesOrigen", fields: [especie_origen_id], references: [id])
  especie_destino_id Int
  especieDestino     Especie        @relation("EvolucionesDestino", fields: [especie_destino_id], references: [id])
  stat_vinculado     StatVinculado?
  es_corrupta        Boolean        @default(false)
}

model MisionConfig {
  id                     String   @id @default(uuid())
  codigo                 String   @unique 
  nombre                 String   
  duracion_seg           Int      
  costo_hambre           Float
  costo_suciedad         Float
  costo_hp               Float    @default(0)
  min_nanocredits        Int
  max_nanocredits        Int
  min_md                 Float
  max_md                 Float
  probabilidad_drop_item Float    @default(0.0) 
  petsEnMision           Pet[]
}

model TrainingConfig {
  id                Int      @id @default(autoincrement())
  stat_tipo         StatTipo 
  nivel_maquina     Int      @default(1)
  costo_hambre      Float
  costo_suciedad    Float
  costo_hp          Float
  min_gain          Float    
  max_gain          Float    
  costo_upgrade_oro Int      @default(100)

  @@unique([stat_tipo, nivel_maquina])
}

// ==========================================
// --- ENUMS ---
// ==========================================

enum TipoEspecie {
  Vacuna
  Virus
  Datos
}

enum RangoEspecie {
  Baby
  Junior
  Champion
  Master
  Corrupt
}

enum StatVinculado {
  F 
  A 
  D 
  N 
}

enum StatTipo {
  Fuerza
  Agilidad
  Defensa
}